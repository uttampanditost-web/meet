rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User collections and records
    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Shared / direct trainer, slot, and attendance collections
    match /trainers/{trainerId} {
      allow read, write: if true;
    }

    match /slots/{slotId} {
      allow read, write: if true;
    }

    match /attendanceLogs/{logId} {
      allow read, write: if true;
    }

    match /userAccess/{docId} {
      allow read, write: if true;
    }

    match /access_roles/{docId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
